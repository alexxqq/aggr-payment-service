# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8001

# Database (PostgreSQL)
# Use 127.0.0.1 (not localhost) when running Postgres in Docker on macOS
DATABASE_URL=postgresql+asyncpg://payment:password@127.0.0.1:5434/payment_service_db

# Internal service-to-service auth
# Must match INTERNAL_API_SECRET in all other services
INTERNAL_API_SECRET=your-internal-service-secret-change-in-production

# User Service base URL (internal network)
USER_SERVICE_URL=http://user-service:8000

# Blockchain Core base URL (internal network)
BLOCKCHAIN_CORE_URL=http://blockchain-core:8003
