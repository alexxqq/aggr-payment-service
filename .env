# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8001

# Database (PostgreSQL)
# Use 127.0.0.1 (not localhost) when running Postgres in Docker on macOS
DATABASE_URL=postgresql+asyncpg://payment:password@127.0.0.1:5434/payment_service_db

# Internal service-to-service auth
# Must match INTERNAL_API_SECRET in all other services
INTERNAL_API_SECRET=your-internal-service-secret-change-in-production

# User Service base URL (internal network)
USER_SERVICE_URL=http://localhost:8002

# Blockchain Core base URL
BLOCKCHAIN_CORE_URL=http://localhost:8003

# Aggregator hot wallets — customer payments land here.
# Replace with your actual addresses before demo.
AGGREGATOR_WALLET_ETHEREUM=0x12666CD1333D7aF5969D0B621c7cA736b2893494
AGGREGATOR_WALLET_BSC=0x0000000000000000000000000000000000000002
AGGREGATOR_WALLET_TRON=T9yD14Nj9j7xAB4dbGeiX9h8unkKHxuWwb

# CoinGecko API for real-time price oracle
COINGECKO_API_KEY=CG-VWbiQSeXcLaJTABYv2D5qX2H
